    <string name="action_start">開始</string>
    <string name="action_stop">停止</string>
    <string name="desc_toggle_start">処理を開始する</string>
    <string name="desc_toggle_stop">処理を停止する</string>

    <!-- 権限 -->
    <string name="perm_mic_required">マイクの権限が必要です。設定から許可してください。</string>
    <string name="perm_notification_hint">通知を許可すると、常駐中の状態と停止ボタンが通知に出ます。</string>

