    <string name="app_name">カツオ</string>

    <!-- ヘッダ -->
    <string name="brand">カツオ</string>
    <string name="status_stopped">停止中</string>
    <string name="status_starting">同期中</string>
    <string name="status_running">動作中</string>
    <string name="latency_unknown">-- ms</string>
    <string name="latency_format">往復 %1$.1f ms</string>
    <string name="latency_measuring">測定中</string>
    <string name="info_latency_title">遅延表示</string>
    <string name="info_latency_body">マイクからイヤホンまでの往復時間です。20 ミリ秒以下なら生音とほぼ重なって聞こえます。Bluetooth イヤホンは 100 ミリ秒以上遅れるため、この用途では有線イヤホンを使ってください。</string>

    <!-- 使い方(状態カード) -->
    <string name="usage_stopped">1. 有線イヤホンをつなぐ\n2. 開始を押す\n3. 音の高さを合わせる</string>
    <string name="usage_running">動作中 — 画面を消しても動きます。止めるには停止を押すか、通知の「停止」を押してください。</string>

    <!-- なめらかさプリセット -->
    <string name="preset_title">なめらかさプリセット</string>
    <string name="preset_20">20 ms</string>
    <string name="preset_50">50 ms</string>
    <string name="preset_100">100 ms</string>
    <string name="preset_200">200 ms</string>
    <string name="info_presets_title">なめらかさプリセット</string>
    <string name="info_presets_body">反応優先(20ms)/ 標準(50ms)/ 音質優先(100ms)/ 最大(200ms)の 4 段階から選べます。反応優先は声の動きに素早く追従しますが、ざらつきが出やすくなります。数値が大きいほどなめらかになりますが、動きへの追従が遅れます。既定値 −89 セントでは跳躍間隔が約 190ms のため、200ms 付近まで伸ばすと常に片方からもう片方へつなぎ続ける状態になります。迷ったら標準のままで問題ありません。</string>

    <!-- 主役カード: 音の高さ -->
    <string name="shift_title">音の高さ</string>
    <string name="shift_unit">セント</string>
    <string name="shift_sub_label">低く ← → 高く</string>
    <string name="label_low">低く</string>
    <string name="label_high">高く</string>
    <string name="tag_left">L</string>
    <string name="tag_right">R</string>
    <string name="step_down">−</string>
    <string name="step_up">+</string>
    <string name="desc_step_down_l">シフト量を下げる</string>
    <string name="desc_step_up_l">シフト量を上げる</string>
    <string name="desc_step_down_r">シフト量 R を下げる</string>
    <string name="desc_step_up_r">シフト量 R を上げる</string>
    <string name="desc_slider_l">シフト量(セント)</string>
    <string name="desc_slider_r">シフト量 R(セント)</string>
    <string name="info_shift_title">音の高さ(シフト量)</string>
    <string name="info_shift_body">入ってきた音を、どれだけ高く / 低くして聞くかです。100 で半音、200 で全音、1200 で 1 オクターブ変わります。マイナスにすると低く聞こえます。作者本人の既定値は −89(半音よりわずかに狭い)です。</string>

    <!-- 数値の直接入力 -->
    <string name="shift_tap_hint">数値をタップして直接入力できます</string>
    <string name="desc_shift_tap_l">タップしてシフト量を入力(L)</string>
    <string name="desc_shift_tap_r">タップしてシフト量を入力(R)</string>
    <string name="shift_input_title_l">シフト量を入力(L)</string>
    <string name="shift_input_title_r">シフト量を入力(R)</string>
    <string name="shift_input_hint">−1200 〜 1200</string>
    <string name="dialog_ok">OK</string>
    <string name="dialog_cancel">キャンセル</string>

    <!-- ジャンプ / ユーザープリセット -->
    <string name="jump_preset_title">ジャンプ / プリセット</string>
    <string name="info_jump_preset_title">ジャンプ / プリセット</string>
    <string name="info_jump_preset_body">最小・0・既定・最大をタップすると、その値へ左右まとめて移動します(左右を別々に設定していても両方動きます)。P1〜P3 は自分でよく使う値を登録できるボタンです。タップで呼び出し、長押しで現在の値(L と R のペア)を上書き登録します。</string>

    <string name="jump_min">最小\n−1200</string>
    <string name="jump_zero">0</string>
    <string name="jump_default">既定\n−89</string>
    <string name="jump_max">最大\n+1200</string>
    <string name="desc_jump_min">シフト量を最小値 −1200 セントにする</string>
    <string name="desc_jump_zero">シフト量を 0 セントにする</string>
    <string name="desc_jump_default">シフト量を既定値 −89 セントにする</string>
    <string name="desc_jump_max">シフト量を最大値 +1200 セントにする</string>

    <string name="user_preset_subtitle">ユーザープリセット</string>
    <string name="preset_slot_name">P%1$d</string>
    <string name="preset_slot_unset">—</string>
    <string name="desc_preset_slot">プリセット %1$d(%2$s)</string>
    <string name="preset_saved_single">プリセット %1$d に %2$s を登録しました</string>
    <string name="preset_saved_pair">プリセット %1$d に %2$s / %3$s を登録しました</string>
    <string name="preset_unset_hint">長押しで現在の値を登録します</string>

    <!-- 刻み幅(範囲切替を置き換え) -->
    <string name="step_title">刻み幅</string>
    <string name="step_whole_tone">全音\n200</string>
    <string name="step_semitone">半音\n100</string>
    <string name="step_quarter_tone">1/4 音\n50</string>
    <string name="step_eighth_tone">1/8 音\n25</string>
    <string name="step_name_whole_tone">全音</string>
    <string name="step_name_semitone">半音</string>
    <string name="step_name_quarter_tone">1/4 音</string>
    <string name="step_name_eighth_tone">1/8 音</string>
    <string name="step_hint_down_format">%1$s 下げる</string>
    <string name="step_hint_up_format">%1$s 上げる</string>
    <string name="info_step_title">刻み幅</string>
    <string name="info_step_body">−/+ ボタンを 1 回押したときに、シフト量がどれだけ変わるかです。細かく合わせたいときは 1/8 音、大きく動かしたいときは全音を選んでください。</string>

    <string name="split_label">左右を別々に設定</string>
    <string name="info_split_title">左右を別々に</string>
    <string name="info_split_body">左右の耳で聞こえ方が違う人向けの機能です。ON にすると、左右のイヤホンで別々の高さに調整できます。</string>

    <!-- 音量 -->
    <string name="volume_label">音量</string>
    <string name="volume_sub_label">小さく ← → 大きく</string>
    <string name="volume_format">%1$+.0f dB</string>
    <string name="desc_volume_slider">音量(dB)</string>
    <string name="desc_volume_down">音量を 1dB 下げる</string>
    <string name="desc_volume_up">音量を 1dB 上げる</string>
    <string name="info_volume_title">音量</string>
    <string name="info_volume_body">イヤホンに出す音の大きさです。上げすぎると音が歪んでしまうため、自動でやわらかく抑えます(ソフトクリップ)。端末の音量キーでも調整できます。</string>

    <!-- 詳細設定 -->
    <string name="adv_title">詳細設定</string>
    <string name="adv_open">詳細設定</string>
    <string name="dry_wet_label">原音まぜ(Dry/Wet)</string>
    <string name="crossfade_label">なめらかさ</string>
    <string name="crossfade_sub_label">速い反応 ← → なめらか</string>
    <string name="desc_drywet_down">原音まぜを 0.05 下げる</string>
    <string name="desc_drywet_up">原音まぜを 0.05 上げる</string>
    <string name="desc_xfade_down">なめらかさを 1 ミリ秒短くする</string>
    <string name="desc_xfade_up">なめらかさを 1 ミリ秒長くする</string>
    <string name="crossfade_format">%1$d ms</string>
    <string name="info_drywet_title">原音まぜ(Dry/Wet)</string>
    <string name="info_drywet_body">0 で元の音そのまま、1 で変換した音だけになります。間の値では両方をまぜて聞こえます。</string>
    <string name="info_crossfade_title">なめらかさ(窓長)</string>
    <string name="info_crossfade_body">音のつなぎ方の長さです。短いと反応が速いですが、ざらつきやうねりが出やすくなります。長いとなめらかですが、音のにじみが増えます。遅延には影響しません。既定値 −89 セントでは、走査幅から決まる跳躍間隔が約 190ms のため、窓長をその付近(200ms)まで伸ばすと常に片方の読み出しヘッドからもう片方へクロスフェードし続ける状態になります。</string>

    <!-- 音源カード(v0.4.0) -->
    <string name="source_card_title">音源</string>

    <string name="mic_gain_label">マイク</string>
    <string name="mic_gain_off">OFF</string>
    <string name="desc_mic_gain_slider">マイク音量(dB)</string>
    <string name="desc_mic_gain_down">マイク音量を 1dB 下げる</string>
    <string name="desc_mic_gain_up">マイク音量を 1dB 上げる</string>
    <string name="info_mic_gain_title">マイク</string>
    <string name="info_mic_gain_body">この端末のマイクが拾う音の大きさです。スライダを一番左まで下げると「OFF」になり、マイクの音が完全に無音になります(捕獲音だけを聴きたいときに使います)。</string>

    <string name="capture_label">他アプリの音を拾う</string>
    <string name="desc_capture_gain_slider">他アプリの音の音量(dB)</string>
    <string name="desc_capture_gain_down">他アプリの音の音量を 1dB 下げる</string>
    <string name="desc_capture_gain_up">他アプリの音の音量を 1dB 上げる</string>
    <string name="info_capture_title">他アプリの音を拾う</string>
    <string name="info_capture_body">ON にすると、他のアプリが再生している音(YouTube や音楽アプリなど)も、マイクの音と同じようにピッチシフトして混ぜます。ON にした状態で開始すると、画面の共有を許可する確認画面が出ます(録画はされません)。\n\n原音がそのまま二重に聞こえないようにする使い方: 原音を「ダミーの Bluetooth イヤホン」に流し、このアプリの出力先には有線(USB)イヤホンを選んでください。こうすると、耳には変換した音だけが届きます。\n\nDRM 付きの音声(一部の動画配信など)や、キャプチャを拒否する設定のアプリの音は拾えません。捕獲した音には生音の漏れ込みが無いため、走査幅は「詳細設定」で別に広めの値に固定されています。</string>
    <string name="capture_status_with_gain">%1$s ・ %2$+.0f dB</string>
    <string name="capture_status_stopped">停止中</string>
    <string name="capture_status_waiting">同意待ち…</string>
    <string name="capture_status_capturing">捕獲中</string>
    <string name="capture_status_silence">捕獲中(他アプリが音を出していません)</string>
    <string name="capture_denied_hint">他アプリの音を拾う許可が得られなかったため、マイクのみで開始しました。</string>
    <string name="capture_error_engine_not_running">捕獲を開始できません(エンジン未起動)</string>
    <string name="capture_error_buffer">捕獲用の録音バッファを確保できません</string>
    <string name="capture_error_open">捕獲用の AudioRecord を初期化できません</string>
    <string name="capture_error_generic">他アプリの音を拾えませんでした: %1$s</string>
    <string name="restart_capture_consent_hint">設定を反映するため再起動します。他アプリの音を拾う設定が ON のため、同意画面が再び表示されます。</string>

    <!-- 出力先 / 入力元 -->
    <string name="output_device_label">出力先</string>
    <string name="input_device_label">入力元</string>
    <string name="device_auto">自動</string>
    <string name="info_output_device_title">出力先</string>
    <string name="info_output_device_body">音を出すデバイスを指定します。「自動」では OS が選んだデバイス(通常はいま挿さっているイヤホン)が使われます。指定したデバイスで開けなかった場合は自動で開き直し、診断欄に「フォールバック」と表示します。抜き差しすると一覧は自動で更新されます。</string>
    <string name="info_input_device_title">入力元</string>
    <string name="info_input_device_body">マイクとして使うデバイスを指定します。「自動」では OS が選んだデバイス(通常は本体マイク)が使われます。指定したデバイスで開けなかった場合は自動で開き直し、診断欄に「フォールバック」と表示します。</string>
    <string name="device_type_usb_headset">USB ヘッドセット</string>
    <string name="device_type_usb_device">USB オーディオ</string>
    <string name="device_type_wired_headset">有線ヘッドセット</string>
    <string name="device_type_wired_headphones">有線イヤホン</string>
    <string name="device_type_bluetooth">Bluetooth</string>
    <string name="device_type_speaker">本体スピーカー</string>
    <string name="device_type_builtin_mic">本体マイク</string>
    <string name="device_type_earpiece">受話口</string>
    <string name="device_type_other">その他のデバイス</string>
    <string name="device_fallback_yes">フォールバック</string>
    <string name="device_fallback_no">指定どおり</string>

    <!-- 走査幅(マイク経路) -->
    <string name="sweep_label">走査幅(マイク経路)</string>
    <string name="sweep_sub_label">短い ← → 長い(聴感ヒアリング用)</string>
    <string name="info_sweep_title">走査幅(マイク経路)</string>
    <string name="info_sweep_body">ディレイラインの読み出しヘッドが往復する幅です。大きいほど跳躍(つなぎ目)の間隔が広がって歪みが減りますが、その分だけ遅延が増えます(設計値遅延 ≈ 8 サンプル + 走査幅の半分)。既定は 9.5ms で、往復遅延 10ms 以下の目標に収まる値です。数値を大きくして聴感を確かめたいときに使ってください(捕獲音の走査幅には影響しません。捕獲音は生音の漏れ込みが無いため別枠で広めに固定されています)。</string>

    <!-- 出力用途(実験) -->
    <string name="output_usage_label">出力をユーザー補助の音量系統に載せる(実験)</string>
    <string name="output_usage_sub_label">端末の音量キーがこの用途の音量に切り替わります</string>
    <string name="info_output_usage_title">出力用途(実験)</string>
    <string name="info_output_usage_body">ON にすると、このアプリの出力がメディア音量ではなく「ユーザー補助」の音量系統で鳴ります。メディア音量をミュートしても本アプリの音だけを鳴らせるかを試す実験的な設定です。ON のあいだ、端末の音量キーはメディア音量ではなくユーザー補助音量を操作します。変更は次の開始から反映されます。</string>

