<?xml version="1.0" encoding="utf-8"?>
<!--
  web/assets/icon.svg を手でアダプティブアイコンの前景に起こしたもの。

  元の SVG は 512x512 で、耳飾りとして吊るされた三角プリズムに左から白色光が
  入り、右へ 6 色の帯が扇状に広がる意匠。ここでは 108x108 の座標系に描き直し、
  内容をすべてセーフゾーン(中心 54,54 / 半径 36)の内側に収めている。
  そのため元 SVG のグラデーション・ブルーム・内部の色分散は落とし、
  「フック + プリズム + 白い入射光 + 6 色の扇」だけを残した。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 入射する白色光。左から細く絞られてプリズムの入射面へ。 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M24,42.5 L42.7,48.5 L42.7,49.7 L24,45.5 Z" />

    <!-- プリズム本体(ガラス面) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.10"
        android:pathData="M52,33 L69,62 L35,62 Z" />

    <!-- プリズム内部を進む光の芯 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M42.7,48.5 L64.2,53.2 L64.2,55.2 L42.7,49.7 Z" />

    <!-- 射出後のスペクトル。中心が下へ向かう = ピッチが下がる。 -->
    <path android:fillColor="#FFFF3B45"
        android:pathData="M64.2,53.20 L86,46.0 L86,50.0 L64.2,53.53 Z" />
    <path android:fillColor="#FFFF9124"
        android:pathData="M64.2,53.53 L86,50.0 L86,54.0 L64.2,53.87 Z" />
    <path android:fillColor="#FFFFDB2E"
        android:pathData="M64.2,53.87 L86,54.0 L86,58.0 L64.2,54.20 Z" />
    <path android:fillColor="#FF3FD25E"
        android:pathData="M64.2,54.20 L86,58.0 L86,62.0 L64.2,54.53 Z" />
    <path android:fillColor="#FF3C8DFF"
        android:pathData="M64.2,54.53 L86,62.0 L86,66.0 L64.2,54.87 Z" />
    <path android:fillColor="#FFA663FF"
        android:pathData="M64.2,54.87 L86,66.0 L86,70.0 L64.2,55.20 Z" />

    <!-- プリズムの稜線 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.85"
        android:strokeWidth="1.4"
        android:strokeLineJoin="round"
        android:pathData="M52,33 L69,62 L35,62 Z" />

    <!-- 耳金具: フックと丸カン -->
    <path
        android:strokeColor="#FFE8C877"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M52,28.5 L52,24 C52,19.5 45.5,19.5 45.5,24 L45.5,27.5" />
    <path
        android:strokeColor="#FFE8C877"
        android:strokeWidth="1.4"
        android:pathData="M54,30.5 A2,2 0 1,1 50,30.5 A2,2 0 1,1 54,30.5 Z" />
</vector>
